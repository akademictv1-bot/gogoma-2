rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── CONFIGURAÇÕES MUNICIPAIS ───────────────────────────────────────
    // Leitura pública (logo, telefone de emergência). Escrita autenticada.
    match /configuracoes/{id} {
      allow read: if true;
      allow write: if true;
    }

    // ─── UTILIZADORES ───────────────────────────────────────────────────
    // Leitura pública (necessária para verificar se número existe no login).
    // Criação aberta (registo público). Atualização permitida (cooldown SOS).
    // Apagar é proibido.
    match /usuarios/{phoneNumber} {
      allow read:   if true;
      allow create: if request.resource.data.keys().hasAll(['name', 'phoneNumber', 'city', 'neighborhood'])
                    && request.resource.data.name is string
                    && request.resource.data.phoneNumber is string;
      allow update: if true;
      allow delete: if false;
    }

    // ─── EMERGÊNCIAS / SOS ──────────────────────────────────────────────
    // Criação pública (cidadão). Atualização pública (comando usa auth próprio).
    // Apagar permitido para o comando limpar o histórico resolvido.
    match /emergencias/{id} {
      allow read:   if true;
      allow create: if request.resource.data.keys().hasAll(['userName', 'contactNumber', 'timestamp', 'status'])
                    && (request.resource.data.status == 'NOVO' || request.resource.data.status == 'novo');
      allow update: if true;
      allow delete: if true;
    }

    // ─── TOKENS DE NOTIFICAÇÃO ──────────────────────────────────────────
    match /operatorTokens/{id} {
      allow read:   if true;
      allow write:  if true;
      allow delete: if false;
    }

    // ─── CREDENCIAIS DO COMANDO ─────────────────────────────────────────
    match /comando_universal/{id} {
      allow read:   if true;
      allow write:  if false;
    }

    // ─── AUDITORIA ──────────────────────────────────────────────────────
    // Escrita pública (comando usa auth próprio). Leitura pública.
    match /auditoria/{id} {
      allow write: if true;
      allow read: if true;
    }

    // ─── ALERTAS MUNICIPAIS ─────────────────────────────────────────────
    // Leitura pública (cidadão). Escrita e eliminação pelo comando.
    match /alertas/{id} {
      allow read:   if true;
      allow write:  if true;
      allow delete: if true;
    }

    // ─── CITIZEN TOKENS (Push Notifications) ────────────────────────────
    // Escrita pública (cidadão). Leitura pública (comando envia push).
    match /citizenTokens/{id} {
      allow read, write: if true;
    }

    // ─── OPERADORES ─────────────────────────────────────────────────────
    // Leitura pública, escrita bloqueada (apenas console).
    match /operadores/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ─── BLOQUEAR TUDO O RESTO ──────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
